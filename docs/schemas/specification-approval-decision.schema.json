{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.invalid/schemas/specification-approval-decision.schema.json",
  "title": "Repoctopus specification approval human decision",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "protocolVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "protocolVersion": { "const": "repoctopus.specification/v1alpha1" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["proposal", "design", "delta-specs", "tasks"] },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "schemaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "instructionDigest", "templateDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["proposal", "design", "delta-specs", "tasks"] },
        "instructionDigest": { "$ref": "#/$defs/digest" },
        "templateDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "schemaInstructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "schemaName", "provider", "artifacts", "digest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "schemaName": { "type": "string", "minLength": 1 },
        "provider": { "$ref": "#/$defs/provider" },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/schemaArtifact" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "specificationRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "storeId", "repositoryId"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "SpecificationRoot" },
        "storeId": { "type": "string", "minLength": 1 },
        "repositoryId": { "type": "string", "minLength": 1 }
      }
    },
    "approvalProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "changeId",
        "specificationRoot",
        "provider",
        "schema",
        "semanticDigest",
        "affectedCapabilities",
        "targetBranch"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "SpecificationApprovalProposal" },
        "changeId": { "type": "string", "minLength": 1 },
        "specificationRoot": { "$ref": "#/$defs/specificationRoot" },
        "provider": { "$ref": "#/$defs/provider" },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "digest"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "semanticDigest": { "$ref": "#/$defs/digest" },
        "affectedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "targetBranch": { "type": "string", "minLength": 1 }
      }
    },
    "changeBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "remoteIdentity", "sourceBranch", "targetBranch", "remoteOid"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "remoteIdentity": { "type": "string", "minLength": 1 },
        "sourceBranch": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "remoteOid": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "decisionType",
        "requestId",
        "changeId",
        "snapshotDigest",
        "proposal",
        "proposalHash",
        "provider",
        "schema",
        "artifacts",
        "affectedCapabilities",
        "changeBranch",
        "options"
      ],
      "properties": {
        "apiVersion": { "const": "repoctopus/v1alpha1" },
        "kind": { "const": "HumanDecisionRequest" },
        "decisionType": { "const": "specification-approval" },
        "requestId": { "type": "string", "minLength": 1 },
        "changeId": { "type": "string", "minLength": 1 },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "proposal": { "$ref": "#/$defs/approvalProposal" },
        "proposalHash": { "$ref": "#/$defs/digest" },
        "provider": { "$ref": "#/$defs/provider" },
        "schema": { "$ref": "#/$defs/schemaInstructions" },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "affectedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "changeBranch": { "$ref": "#/$defs/changeBranch" },
        "options": { "const": ["approve", "revise", "reject"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "proposalHash", "decision"],
      "properties": {
        "apiVersion": { "const": "repoctopus/v1alpha1" },
        "kind": { "const": "HumanDecisionResponse" },
        "requestId": { "type": "string", "minLength": 1 },
        "proposalHash": { "$ref": "#/$defs/digest" },
        "decision": { "enum": ["approve", "revise", "reject"] },
        "comment": { "type": "string", "maxLength": 4096 }
      }
    }
  ]
}
