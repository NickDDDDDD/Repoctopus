{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.invalid/schemas/local-project-config.schema.json",
  "title": "Repoctopus local project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind"],
  "properties": {
    "apiVersion": { "const": "repoctopus/v1alpha1" },
    "kind": { "const": "RepoctopusLocal" },
    "repositoryPaths": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "ports": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "executablePath": { "type": "string", "minLength": 1 } }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallel": { "type": "integer", "minimum": 1 },
        "maxLogBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
