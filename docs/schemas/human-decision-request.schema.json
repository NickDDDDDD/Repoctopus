{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.dev/schemas/human-decision-request.schema.json",
  "title": "Repoctopus Delivery Approval Request v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "requestId",
    "decisionType",
    "changeId",
    "snapshotDigest",
    "reportDigest",
    "evidenceBundleIds",
    "changeBranch",
    "businessDeliveries",
    "businessSplitReason",
    "actions",
    "options"
  ],
  "properties": {
    "apiVersion": { "const": "repoctopus/v1alpha1" },
    "kind": { "const": "HumanDecisionRequest" },
    "requestId": { "type": "string", "minLength": 1 },
    "decisionType": { "const": "delivery-approval" },
    "changeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reportDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceBundleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "changeBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "remoteIdentity", "sourceBranch", "targetBranch", "remoteOid"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "remoteIdentity": { "type": "string", "minLength": 1 },
        "sourceBranch": { "type": "string", "minLength": 1 },
        "targetBranch": { "type": "string", "minLength": 1 },
        "remoteOid": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" }
      }
    },
    "businessDeliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deliveryId",
          "repositoryId",
          "repositoryName",
          "sourceBranch",
          "targetBranch"
        ],
        "properties": {
          "deliveryId": { "type": "string", "minLength": 1 },
          "repositoryId": { "type": "string", "minLength": 1 },
          "repositoryName": { "type": "string", "minLength": 1 },
          "sourceBranch": { "type": "string", "minLength": 1 },
          "targetBranch": { "type": "string", "minLength": 1 }
        }
      }
    },
    "businessSplitReason": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {
            "kind": { "enum": ["multi_repository", "ordered_delivery", "supplemental_fix"] },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionId", "type", "deliveryId", "repositoryId"],
        "properties": {
          "actionId": { "type": "string", "minLength": 1 },
          "type": { "enum": ["git.push", "mr.create_or_update"] },
          "deliveryId": { "type": "string", "minLength": 1 },
          "repositoryId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "options": { "const": ["approve", "request_changes", "reject"] }
  }
}
