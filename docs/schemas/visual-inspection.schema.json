{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.invalid/schemas/visual-inspection.schema.json",
  "title": "Repoctopus visual inspection protocol",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "requestId",
        "screenshot",
        "viewport",
        "page",
        "criteria",
        "designReferences"
      ],
      "properties": {
        "apiVersion": { "const": "repoctopus/v1alpha1" },
        "kind": { "const": "VisualInspectionRequest" },
        "requestId": { "type": "string", "minLength": 1 },
        "screenshot": { "type": "object" },
        "viewport": {
          "type": "object",
          "required": ["width", "height", "deviceScaleFactor"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "page": { "type": "object" },
        "criteria": { "type": "array", "minItems": 1 },
        "designReferences": { "type": "array" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "responseId", "requestId", "screenshotSha256", "findings"],
      "properties": {
        "apiVersion": { "const": "repoctopus/v1alpha1" },
        "kind": { "const": "VisualInspectionResponse" },
        "responseId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "screenshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "findings": { "type": "array" }
      }
    }
  }
}
