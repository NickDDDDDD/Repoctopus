{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.invalid/schemas/project-config.schema.json",
  "title": "Repoctopus shared project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "project", "repositories", "profiles"],
  "properties": {
    "apiVersion": { "const": "repoctopus/v1alpha1" },
    "kind": { "const": "RepoctopusProject" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/commandNode" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAgeDays": { "type": "integer", "minimum": 1 },
            "minRecentSuccesses": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "commandNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "repository", "executable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "command" },
        "repository": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required": { "type": "boolean" },
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "cache": { "type": "boolean" },
        "cacheTtlMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
