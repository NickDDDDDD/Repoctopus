{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.invalid/schemas/project-detection-draft.schema.json",
  "title": "Repoctopus project detection draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "draftId",
    "status",
    "capturedAt",
    "scanRoot",
    "workspace",
    "repositories",
    "unresolved",
    "candidateConfig",
    "baseConfigDigest",
    "reconcile",
    "storeBinding"
  ],
  "properties": {
    "apiVersion": { "const": "repoctopus/v1alpha1" },
    "kind": { "const": "ProjectDetectionDraft" },
    "draftId": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "status": { "enum": ["candidate", "awaiting_confirmation", "confirmed"] },
    "capturedAt": { "type": "string", "format": "date-time" },
    "scanRoot": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "repositories": { "type": "array", "items": { "$ref": "#/$defs/repository" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
    "candidateConfig": {
      "anyOf": [{ "$ref": "project-config.schema.json" }, { "type": "null" }]
    },
    "baseConfigDigest": {
      "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
    },
    "reconcile": {
      "anyOf": [{ "$ref": "#/$defs/reconcile" }, { "type": "null" }]
    },
    "storeBinding": {
      "anyOf": [{ "$ref": "#/$defs/storeBinding" }, { "type": "null" }]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "file", "detail"],
      "properties": {
        "repositoryId": { "type": "string" },
        "file": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "executable", "args", "cwd", "confidence", "sources"],
      "properties": {
        "id": { "type": "string" },
        "repository": { "type": "string" },
        "executable": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "confidence": { "enum": ["confirmed", "inferred"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "zeroTests": { "enum": ["warning", "blocking"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "confidence", "sources"],
      "properties": {
        "id": { "type": "string" },
        "repository": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "healthEndpoint": { "type": "string" },
        "confidence": { "enum": ["confirmed", "inferred"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "remoteIdentity", "technologies", "commands", "services", "openSpec"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "remoteIdentity": { "type": ["string", "null"] },
        "technologies": {
          "type": "array",
          "items": { "enum": ["node", "maven", "gradle"] }
        },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "openSpec": { "$ref": "#/$defs/storeRepository" }
      }
    },
    "pointerDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after"],
      "properties": {
        "path": { "const": "openspec/config.yaml" },
        "before": { "type": ["string", "null"] },
        "after": { "type": ["string", "null"] }
      }
    },
    "storeRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "classification", "selection", "configuredStoreId", "pointerDiff", "diagnostic"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["workspace-store", "unconfigured", "same-store", "other-store", "local-authority", "damaged", "read-only"] },
        "selection": { "enum": ["install", "keep", "skip", "blocked"] },
        "configuredStoreId": { "type": ["string", "null"] },
        "pointerDiff": { "anyOf": [{ "$ref": "#/$defs/pointerDiff" }, { "type": "null" }] },
        "diagnostic": { "type": ["string", "null"] }
      }
    },
    "storeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeId", "workspaceRepositoryId", "workspaceRoot", "repositories"],
      "properties": {
        "storeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "workspaceRepositoryId": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "repositories": { "type": "array", "items": { "$ref": "#/$defs/storeRepository" } }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "repository", "message"],
      "properties": {
        "code": {
          "enum": ["unknown-build", "service-port", "health-endpoint", "command-review"]
        },
        "repository": { "type": "string" },
        "message": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "addedRepositories",
        "removedRepositories",
        "addedNodes",
        "removedNodes",
        "conflicts"
      ],
      "properties": {
        "changed": { "type": "boolean" },
        "addedRepositories": { "type": "array", "items": { "type": "string" } },
        "removedRepositories": { "type": "array", "items": { "type": "string" } },
        "addedNodes": { "type": "array", "items": { "type": "string" } },
        "removedNodes": { "type": "array", "items": { "type": "string" } },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "current", "candidate"],
            "properties": {
              "field": { "type": "string" },
              "current": true,
              "candidate": true
            }
          }
        }
      }
    }
  }
}
