{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoctopus.invalid/schemas/evidence-envelope.schema.json",
  "title": "Repoctopus Evidence envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/artifactRef"
    },
    {
      "$ref": "#/$defs/attempt"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/bundle"
    },
    {
      "$ref": "#/$defs/gateProjection"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["apiVersion", "kind"],
      "properties": {
        "apiVersion": {
          "const": "repoctopus/v1alpha1"
        }
      }
    },
    "artifactRef": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": ["kind", "sha256", "size", "mediaType", "artifactType", "redacted"],
          "properties": {
            "kind": {
              "const": "ArtifactRef"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "mediaType": {
              "type": "string",
              "minLength": 1
            },
            "artifactType": {
              "type": "string",
              "minLength": 1
            },
            "redacted": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "attempt": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "attemptId",
            "profileId",
            "inputFingerprint",
            "startedAt",
            "receiptIds",
            "status",
            "schemaVersion",
            "compositionDigest",
            "dependencies"
          ],
          "properties": {
            "kind": {
              "const": "EvidenceAttempt"
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "profileId": {
              "type": "string",
              "minLength": 1
            },
            "inputFingerprint": {
              "type": "string",
              "minLength": 1
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            },
            "receiptIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": ["running", "completed", "superseded"]
            },
            "schemaVersion": {
              "const": 1
            },
            "compositionDigest": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "$ref": "#/$defs/dependencyRecord"
            }
          }
        }
      ]
    },
    "receipt": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "receiptId",
            "attemptId",
            "nodeId",
            "adapter",
            "trust",
            "freshness",
            "status",
            "inputFingerprint",
            "startedAt",
            "completedAt",
            "artifacts",
            "findings",
            "schemaVersion",
            "compositionDigest",
            "dependencies",
            "sourceFingerprint",
            "derivedInputs",
            "outputManifest"
          ],
          "properties": {
            "kind": {
              "const": "EvidenceReceipt"
            },
            "receiptId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "trust": {
              "enum": ["verified", "observed"]
            },
            "freshness": {
              "enum": ["fresh", "reused", "superseded"]
            },
            "status": {
              "enum": ["passed", "failed", "incomplete"]
            },
            "inputFingerprint": {
              "type": "string",
              "minLength": 1
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            },
            "exitCode": {
              "type": "integer"
            },
            "validUntil": {
              "type": "string",
              "format": "date-time"
            },
            "sourceReceiptId": {
              "type": "string",
              "minLength": 1
            },
            "process": {
              "type": "object",
              "required": ["pid"],
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 1
                },
                "identity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifactRef"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "schemaVersion": {
              "const": 1
            },
            "compositionDigest": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "$ref": "#/$defs/dependencyRecord"
            },
            "sourceFingerprint": {
              "type": "string",
              "minLength": 1
            },
            "derivedInputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["producerId", "producerReceiptId", "manifest", "contentDigest"],
                "properties": {
                  "producerId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "producerReceiptId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "manifest": {
                    "$ref": "#/$defs/artifactRef"
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            },
            "outputManifest": {
              "oneOf": [
                {
                  "$ref": "#/$defs/artifactRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "gateProjection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "workflowRunId",
        "workflowActionId",
        "workflowStepId",
        "workflowStateVersion",
        "profileId",
        "bundleId",
        "inputFingerprint",
        "outcome",
        "status",
        "reason",
        "compositionDigest",
        "dependencies",
        "checkEpoch",
        "verificationInputDigest",
        "acceptanceSetHash",
        "failureKind"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "kind": {
          "const": "EvidenceGateProjection"
        },
        "workflowRunId": {
          "type": ["string", "null"]
        },
        "workflowActionId": {
          "type": ["string", "null"]
        },
        "workflowStepId": {
          "type": ["string", "null"]
        },
        "workflowStateVersion": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "bundleId": {
          "type": "string",
          "minLength": 1
        },
        "inputFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": ["passed", "failed", "incomplete", "passed_with_warnings"]
        },
        "status": {
          "enum": ["satisfied", "blocked"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "compositionDigest": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyRecord"
        },
        "checkEpoch": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "verificationInputDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "acceptanceSetHash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "failureKind": {
          "enum": ["none", "implementation", "input-drift", "unavailable"]
        }
      }
    },
    "bundle": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bundleId",
            "attemptId",
            "profileId",
            "inputFingerprint",
            "createdAt",
            "outcome",
            "checks",
            "receiptIds",
            "artifactDigests",
            "findings",
            "schemaVersion",
            "compositionDigest",
            "dependencies",
            "acceptanceTrace"
          ],
          "properties": {
            "kind": {
              "const": "EvidenceBundle"
            },
            "bundleId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "profileId": {
              "type": "string",
              "minLength": 1
            },
            "inputFingerprint": {
              "type": "string",
              "minLength": 1
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "outcome": {
              "enum": ["passed", "failed", "incomplete", "passed_with_warnings"]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "receiptIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "artifactDigests": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "schemaVersion": {
              "const": 3
            },
            "compositionDigest": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "$ref": "#/$defs/dependencyRecord"
            },
            "acceptanceTrace": {
              "type": ["object", "null"]
            },
            "verificationReport": {
              "$ref": "#/$defs/artifactRef"
            }
          }
        }
      ]
    },
    "dependencyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "subjectKind",
        "subjectId",
        "dependencies",
        "dependsOnEvidenceIds",
        "digest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "subjectKind": {
          "enum": [
            "attempt",
            "plan-evidence",
            "receipt",
            "bundle",
            "gate",
            "build-check",
            "verification-input"
          ]
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partition", "identity"],
            "properties": {
              "partition": {
                "enum": [
                  "implementation-content",
                  "planning-semantic",
                  "execution-control",
                  "git-identity",
                  "publication-provenance"
                ]
              },
              "identity": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        },
        "dependsOnEvidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
