{
  "schemaVersion": 1,
  "reviewedSourceRoots": ["app", "domains", "platform", "plugins", "services"],
  "capabilities": [
    {
      "id": "plugin-composition",
      "disposition": "repoctopus-native",
      "targets": [
        "app/boot/**",
        "app/desktop/host/**",
        "app/desktop/main/main.ts",
        "app/desktop/main/product-root.ts",
        "app/desktop/main/startup.ts",
        "app/desktop/preload/**",
        "app/desktop/renderer/**",
        "app/desktop/shared/**",
        "app/runner/**",
        "domains/composition/**",
        "plugins/builtin-catalog.ts",
        "plugins/action/**",
        "plugins/application/**",
        "plugins/delivery/**",
        "plugins/evidence/**",
        "plugins/http/**",
        "plugins/project/**",
        "plugins/run/**",
        "plugins/command/delivery-contributor.ts",
        "plugins/command/evidence-contributor.ts",
        "plugins/command/maintenance-contributor.ts",
        "plugins/command/project-onboarding-contributor.ts",
        "plugins/command/project-probe-contributor.ts",
        "plugins/command/workflow-run-contributor.ts",
        "services/**",
        "platform/http/**"
      ],
      "upstream": ["third_party/cordis", "third_party/cordis-plugin-loader"],
      "rationale": "App Boot 把 Repoctopus 领域配置编译为唯一 Cordis 插件树，并把生命周期交给 Cordis。"
    },
    {
      "id": "desktop-shell-lifecycle",
      "disposition": "source-modified",
      "targets": [
        "app/desktop/main/backend-controller.ts",
        "app/desktop/main/host-process.ts",
        "app/desktop/main/node-environment.ts",
        "app/desktop/main/single-instance.ts"
      ],
      "upstream": [
        "apps/desktop/src/backend-controller.ts",
        "apps/desktop/src/host-process.ts",
        "apps/desktop/src/node-environment.ts",
        "apps/desktop/src/single-instance.ts"
      ],
      "rationale": "采用固定 DSH Desktop 的薄 Shell、Node-mode Host、串行恢复、单实例和有界退出模式，并收窄为 Repoctopus OTLP Dashboard 所需契约。"
    },
    {
      "id": "action-execution",
      "disposition": "behavior-reimplemented",
      "targets": ["domains/action/**", "platform/action/**"],
      "upstream": [
        "domains/comet-native/native-check-receipt.ts",
        "domains/comet-native/native-check-receipt-storage.ts"
      ],
      "rationale": "采用 Intent、幂等键和 Receipt 的可恢复副作用边界，按 Repoctopus Engine Action 与多仓 Run 模型重新实现。"
    },
    {
      "id": "engine-adopted",
      "disposition": "source-modified",
      "targets": [
        "domains/engine/evals.ts",
        "domains/engine/guardrails.ts",
        "domains/engine/loop.ts",
        "domains/engine/resolver.ts",
        "domains/workflow-contract/hash.ts"
      ],
      "upstream": ["domains/engine", "domains/workflow-contract/hash.ts"],
      "rationale": "采用 Comet 的确定性 Engine 算法并对接 Repoctopus Workflow Contract。"
    },
    {
      "id": "runtime-core",
      "disposition": "behavior-reimplemented",
      "targets": [
        "domains/engine/types.ts",
        "domains/trajectory/**",
        "domains/workflow-contract/canonical.ts",
        "domains/workflow-contract/package.ts",
        "domains/workflow-contract/types.ts",
        "domains/workflow-contract/validation.ts",
        "platform/process/execute.ts",
        "platform/runtime/paths.ts",
        "platform/workflow/**"
      ],
      "upstream": ["domains/engine/storage-run.ts", "domains/engine/storage-layout.ts"],
      "rationale": "保留 Run、Trajectory、Checkpoint 和恢复语义，避免引入 Comet Skill 与产品目录布局。"
    },
    {
      "id": "change-lifecycle",
      "disposition": "behavior-reimplemented",
      "targets": ["domains/change-lifecycle/**"],
      "upstream": [
        "domains/native-orchestration/workflow-definition.ts",
        "domains/native-orchestration/transition.ts"
      ],
      "rationale": "采用固定定义、纯转换和投影分离原则，为 Repoctopus 的 Workspace、多仓、OpenSpec 与持久 Run 建立唯一 Change 生命周期。"
    },
    {
      "id": "protected-runtime-transitions",
      "disposition": "source-modified",
      "targets": [
        "domains/runtime/**",
        "platform/runtime/file-runtime-store.ts",
        "platform/runtime/recoverable-file-lock.ts",
        "platform/runtime/recoverable-file-transition.ts"
      ],
      "upstream": [
        "domains/comet-classic/classic-command-checks.ts",
        "domains/comet-classic/classic-guard.ts",
        "domains/comet-classic/classic-store.ts",
        "platform/fs/plugin-store.ts"
      ],
      "rationale": "整体采用 Comet 的 Runtime Evidence 复核、受保护状态转换、进程身份锁和 intent Journal 重放不变量；对接 Repoctopus 的多仓 Bundle 与 Run State。"
    },
    {
      "id": "process-safety",
      "disposition": "source-modified",
      "targets": [
        "platform/process/external-command.ts",
        "platform/process/process-identity.ts",
        "platform/process/spawn-command.ts",
        "platform/process/terminate-process-tree.ts",
        "platform/process/windows-process-identity.ts"
      ],
      "upstream": ["platform/process"],
      "rationale": "采用 Comet 已验证的结构化进程、Windows shim、进程身份和进程树终止机制。"
    },
    {
      "id": "filesystem-safety",
      "disposition": "source-modified",
      "targets": ["platform/filesystem/**", "platform/runtime/resource-lease.ts"],
      "upstream": [
        "platform/fs/file-identity.ts",
        "platform/fs/race-safe-read.ts",
        "platform/fs/transient-retry.ts",
        "domains/comet-native/native-atomic-file.ts",
        "domains/comet-native/native-lock.ts"
      ],
      "rationale": "采用文件身份、竞态安全读取、Windows 短暂失败重试和原子写入；Lease 保留 Repoctopus resource key 与进程恢复协议。"
    },
    {
      "id": "project-model",
      "disposition": "repoctopus-native",
      "targets": ["domains/project/**", "platform/git/probe.ts", "platform/git/remote-identity.ts"],
      "upstream": ["platform/project-registry.ts"],
      "rationale": "Repoctopus 以同级多仓为项目边界，项目发现快照只提供启发式候选与恢复核对。"
    },
    {
      "id": "project-onboarding",
      "disposition": "repoctopus-native",
      "targets": ["domains/project-configuration/**", "platform/project-configuration/**"],
      "upstream": [],
      "rationale": "确定性扫描、Agent 补全和用户确认是 Repoctopus 的多仓接入能力。"
    },
    {
      "id": "skill-integration",
      "disposition": "source-modified",
      "targets": [
        "domains/skill/**",
        "plugins/skill/**",
        "plugins/command/skill-catalog-contributor.ts",
        "platform/skill/**"
      ],
      "upstream": [
        "@deepseek-ai/dsh-skill@0.2.1-rc.3",
        "packages/skill/skill-filesystem/src/index.ts",
        "third_party/matt-skills"
      ],
      "rationale": "直接采用 DSH 的 ctx.skills Registry；文件 Provider 仅移除 DSH 文件沙箱和 Home 约定，Matt Skills 作为固定且可替换的内置 Provider。"
    },
    {
      "id": "specification-authority",
      "disposition": "repoctopus-native",
      "targets": [
        "domains/specification/**",
        "platform/specification/**",
        "platform/git/change-branch.ts",
        "plugins/command/specification-contributor.ts"
      ],
      "upstream": ["@fission-ai/openspec@1.14.3"],
      "rationale": "Specification 是唯一 Cordis 权威 Service；OpenSpec Provider 通过受控进程端口映射官方产物生命周期，Workflow 只消费稳定领域契约。"
    },
    {
      "id": "platform-event-processing",
      "disposition": "source-modified",
      "targets": [
        "domains/platform-events/**",
        "platform/events/**",
        "plugins/events/**",
        "plugins/command/platform-event-contributor.ts"
      ],
      "upstream": [
        "packages/experimental/webhook-github/src/handler.ts",
        "packages/experimental/webhook-github/src/body.ts"
      ],
      "rationale": "采用 DSH GitHub Adapter 的先验签后解析、唯一 Header、Content-Type 与体积边界；用 Repoctopus 持久 Inbox 租约和 Receipt 替代 fire-and-forget Session dispatch。"
    },
    {
      "id": "delivery-governance",
      "disposition": "repoctopus-native",
      "targets": [
        "domains/delivery/**",
        "platform/delivery/**",
        "platform/git/delivery.ts",
        "platform/github/**"
      ],
      "upstream": ["domains/comet-native/native-pull-request-finish.ts"],
      "rationale": "交付聚合只负责多仓快照、Human Decision、push/MR 恢复和合入事实，不继承旧工作流 Hook 与阶段状态机。"
    },
    {
      "id": "post-merge-automation",
      "disposition": "repoctopus-native",
      "targets": [
        "domains/post-merge/**",
        "platform/git/post-merge-checkout.ts",
        "platform/git/post-merge-workspace.ts",
        "plugins/command/post-merge-contributor.ts",
        "plugins/post-merge/**"
      ],
      "upstream": [],
      "rationale": "合入事件只唤醒协调；领域判定基于 Delivery 的平台权威刷新结果生成稳定合入事实身份，平台检出只使用固化的精确 merge commit；协调 workspace 的 Git 差异由独立端口读取，领域 Guardrail 再与规格关闭计划和结果交叉核对。"
    },
    {
      "id": "evidence-model",
      "disposition": "behavior-reimplemented",
      "targets": ["domains/evidence/**", "platform/evidence/**"],
      "upstream": [
        "domains/comet-native/native-evidence-storage.ts",
        "domains/comet-native/native-verification-evidence.ts",
        "domains/comet-native/native-verification-receipt.ts",
        "domains/comet-native/native-snapshot.ts",
        "domains/comet-native/native-evidence-retention.ts",
        "domains/comet-native/native-checkpoint-journal.ts"
      ],
      "rationale": "按跨仓 Attempt、Receipt、Artifact、Bundle 重建领域模型；仓库选择与 Fence 算法采用 Comet 行为边界。"
    },
    {
      "id": "repository-fingerprint",
      "disposition": "source-modified",
      "targets": ["platform/git/evidence-fingerprint.ts"],
      "upstream": ["domains/comet-native/native-snapshot.ts"],
      "rationale": "抽取 Comet 的选择前后 Fence、竞态安全内容摘要和输入漂移拒绝规则，并在上层组合多个仓库。"
    },
    {
      "id": "feedback-adapters",
      "disposition": "repoctopus-native",
      "targets": ["domains/feedback/**", "platform/browser/**", "platform/feedback/**"],
      "upstream": [],
      "rationale": "Managed/Attached 服务、Browser Journey、视觉反馈和资料冲突决定是 Repoctopus 新能力。"
    },
    {
      "id": "telemetry",
      "disposition": "repoctopus-native",
      "targets": ["platform/telemetry/**"],
      "upstream": ["platform/process/runtime-metrics.ts"],
      "rationale": "使用 OTel 允许列表导出稳定 Evidence 与交付身份，不复用 Comet 的进程内指标模型。"
    },
    {
      "id": "cli",
      "disposition": "repoctopus-native",
      "targets": ["app/cli/**"],
      "upstream": [],
      "rationale": "公共 CLI 只组合领域服务并输出版本化 Repoctopus envelope。"
    },
    {
      "id": "provenance",
      "disposition": "repoctopus-native",
      "targets": ["platform/provenance/**"],
      "upstream": [],
      "rationale": "机器检查固定上游、目标摘要和公共品牌边界。"
    }
  ],
  "legacyWorkflow": {
    "scanTargets": [
      "app",
      "bin",
      "domains",
      "platform",
      "workflows",
      "deploy",
      "README.md",
      "docs"
    ],
    "excludedTargets": ["docs/architecture-review.md"],
    "forbiddenPaths": [
      ".codex",
      ".opencode",
      ".codebuddy",
      ".codearts",
      ".context",
      ".rules",
      "skills/oh-my-workflow",
      "scripts/workflow-hook.mjs",
      "config/workflow-profile.yaml",
      "workspace/client-adapters.json",
      "workspace.yaml",
      "project.local.yaml"
    ],
    "forbiddenPatterns": [
      "agents-workspace",
      "agent-lab",
      "oh-my-workflow",
      "team-delivery",
      "workspace\\.yaml",
      "project\\.local\\.yaml",
      "APPROVE_DELIVERY",
      "批准报告",
      "批准动作",
      "ACTION_CONFIRMATION_REQUIRED",
      "AWAITING_CLOSE_APPROVAL",
      "CASE:\\b(?:PLANNING|IMPLEMENTING|AWAITING_APPROVAL|DELIVERING|COMPLETED)\\b"
    ]
  },
  "stateTransitionModels": [
    {
      "id": "runtime-transition",
      "files": [
        "domains/trajectory/types.ts",
        "platform/runtime/file-runtime-store.ts",
        "platform/runtime/paths.ts",
        "platform/runtime/recoverable-file-lock.ts",
        "platform/runtime/recoverable-file-transition.ts"
      ],
      "status": "canonical"
    },
    {
      "id": "delivery-transition",
      "files": [
        "platform/delivery/file-delivery-store.ts",
        "platform/delivery/file-delivery-v3-store.ts",
        "platform/runtime/recoverable-file-transition.ts"
      ],
      "status": "shared-coordinator"
    },
    {
      "id": "event-inbox-transition",
      "files": [
        "platform/events/file-event-inbox-store.ts",
        "platform/runtime/recoverable-file-transition.ts"
      ],
      "status": "shared-coordinator"
    },
    {
      "id": "specification-approval-transition",
      "files": [
        "platform/specification/file-planning-approval-store.ts",
        "platform/runtime/recoverable-file-transition.ts"
      ],
      "status": "shared-coordinator"
    },
    {
      "id": "evidence-fact-journal",
      "files": ["domains/evidence/ports.ts", "platform/evidence/file-evidence-journal.ts"],
      "status": "separate-append-only-facts"
    },
    {
      "id": "post-merge-closure-journal",
      "files": ["services/post-merge-actions.ts"],
      "status": "recoverable-action-journal"
    }
  ],
  "compositionGuards": [
    {
      "pattern": "class\\s+(?:RepoctopusRuntime|EvidenceRuntime)\\b|ctx\\.runtime\\b",
      "allowed": []
    },
    {
      "pattern": "new\\s+WorkflowRunCoordinator\\s*\\(",
      "allowed": ["services/workflow-runs.ts"]
    },
    {
      "pattern": "new\\s+FileRuntimeStore\\s*\\(",
      "allowed": ["plugins/run/file-run-store-provider.ts"]
    },
    {
      "pattern": "new\\s+DeliveryDomainService\\s*\\(",
      "allowed": ["plugins/delivery/file-delivery-provider.ts"]
    }
  ],
  "sourceBoundaries": [
    {
      "id": "single-skill-container",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "(?:plugin\\s*:\\s*SkillRegistry\\b|new\\s+SkillRegistry\\s*\\(|\\.plugin\\s*\\(\\s*SkillRegistry\\b)",
      "allowed": ["plugins/builtin-catalog.ts"],
      "exactMatches": 1,
      "message": "Skill providers must contribute through the single registered SkillRegistry container"
    },
    {
      "id": "single-specification-container",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "super\\s*\\(\\s*context\\s*,\\s*['\"]specification['\"]\\s*\\)",
      "allowed": ["services/specification.ts"],
      "exactMatches": 1,
      "message": "Specification providers must extend the single Specification service container"
    },
    {
      "id": "v3-post-merge-configuration",
      "targets": ["app/boot/**", "domains/project-configuration/**", "plugins/post-merge/**"],
      "pattern": "merge_request\\.update|update-existing|changeMergeRequest",
      "allowed": ["domains/project-configuration/config.ts"],
      "message": "Delivery v3 composition must reject, not emit, legacy update-existing Change MR configuration"
    },
    {
      "id": "platform-adapter-run-write",
      "targets": ["platform/**"],
      "pattern": "\\b(?:ctx|context)\\.(?:workflowRuns|runStore)\\b|from\\s+['\"][^'\"]*services/(?:workflow-runs|run-store)\\.js['\"]",
      "allowed": [],
      "message": "Platform adapters must emit verified facts instead of calling WorkflowRuns or RunStore"
    },
    {
      "id": "coordinator-domain-store-write",
      "targets": ["services/post-merge-coordinator.ts"],
      "pattern": "\\b(?:ctx|context)\\.(?:runStore|evidenceCoordinator)\\b|\\b(?:new\\s+)?(?:File)?(?:Runtime|Evidence|Delivery|EventInbox)Store\\b|from\\s+['\"][^'\"]*(?:platform|domains)/[^'\"]*store[^'\"]*['\"]|\\b(?:writeFile|appendFile|rename|rm)\\s*\\(",
      "allowed": [],
      "message": "PostMergeCoordinator must coordinate through services and must not write domain stores or files"
    },
    {
      "id": "specification-provider-closure",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "\\b(?:execute|spawn|json)\\s*(?:<[^>]+>)?\\s*\\([^)]*\\[\\s*['\"]archive['\"]",
      "allowed": ["platform/specification/openspec-provider.ts"],
      "message": "Specification closure commands may only be executed by a Specification Provider"
    },
    {
      "id": "protected-git-publication",
      "targets": ["platform/**"],
      "pattern": "(?:\\bgit\\s*\\([^,]+,\\s*|\\bexecute\\s*\\(\\s*['\"]git['\"]\\s*,\\s*)\\[[^\\]]{0,700}['\"](?:commit|push)['\"]",
      "allowed": ["platform/git/delivery.ts"],
      "message": "Git commit and push may only be executed by the protected Delivery Action adapter"
    },
    {
      "id": "protected-merge-request-publication",
      "targets": ["platform/**"],
      "pattern": "method\\s*:\\s*['\"](?:POST|PATCH)['\"]",
      "allowed": ["platform/github/merge-request.ts"],
      "message": "Merge request creation and updates may only be executed by a protected Delivery Action adapter"
    },
    {
      "id": "desktop-renderer-process-isolation",
      "targets": ["app/desktop/renderer/**"],
      "pattern": "from\\s+['\"](?:node:|electron(?:/|['\"])|@deepseek-ai/cordis(?:/|['\"]))",
      "allowed": [],
      "message": "Desktop Renderer must use the preload bridge and must not import Node, Electron, or Cordis"
    },
    {
      "id": "desktop-shell-cordis-isolation",
      "targets": ["app/desktop/main/**", "app/desktop/preload/**"],
      "pattern": "from\\s+['\"]@deepseek-ai/cordis(?:/|['\"])",
      "allowed": [],
      "message": "Electron Shell and preload must not host or import the Cordis application runtime"
    },
    {
      "id": "single-change-lifecycle-transition-owner",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "type\\s+ChangePhase\\s*=|enum\\s+ChangePhase\\s*\\{|\\b(?:decide|apply|transition)ChangeLifecycle(?:Transition)?\\s*[=(]",
      "allowed": ["domains/change-lifecycle/transition.ts"],
      "message": "Change lifecycle phases and transition decisions belong only to the canonical transition module"
    },
    {
      "id": "direct-run-state-write",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "\\b(?:ctx|context)\\.runStore\\.(?:commit|commitGuarded)\\s*\\(",
      "allowed": [],
      "message": "Callers must submit facts through WorkflowRuns instead of writing Run state directly"
    },
    {
      "id": "independent-post-merge-run-creation",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "\\bpostMergeRun(?:Options|Id)\\s*\\(",
      "allowed": ["domains/post-merge/run.ts", "services/post-merge-coordinator.ts"],
      "message": "Only the registered legacy compatibility path may create a Post-merge Run until Archive migration removes it"
    },
    {
      "id": "caller-selected-lifecycle-method",
      "targets": ["app/**", "domains/**", "platform/**", "plugins/**", "services/**"],
      "pattern": "\\b(?:actionSkill|requiredSkill|augmentationSkills|methodProfile)\\s*:\\s*(?:input|options|request|commandInput)\\.",
      "allowed": [],
      "message": "Lifecycle methods must come from the immutable definition, not caller input"
    }
  ],
  "protectedEvidenceFlow": {
    "requiredBindings": [
      {
        "file": "workflows/foundation.yaml",
        "patterns": ["evidenceProfile: verify"]
      },
      {
        "file": "services/evidence-coordinator.ts",
        "patterns": [
          "export class EvidenceCoordinator extends Service",
          "current.digest !== status.bundle.inputFingerprint",
          "approvedEvidenceBundleIds()"
        ]
      },
      {
        "file": "domains/runtime/workflow-runs.ts",
        "patterns": ["requireSatisfiedEvidenceGate", "evidenceAttemptId"]
      },
      {
        "file": "domains/runtime/evidence-guard.ts",
        "patterns": [
          "projection.workflowRunId !== options.workflowRunId",
          "projection.status !== 'satisfied'"
        ]
      },
      {
        "file": "app/cli/main.ts",
        "patterns": ["evidence-attempt", "evidence-bundles"]
      },
      {
        "file": "domains/delivery/snapshot.ts",
        "patterns": ["evidenceBundleIds"]
      }
    ],
    "restrictedCalls": [
      {
        "pattern": "recordOutcome\\s*\\(",
        "allowed": ["domains/engine/loop.ts", "domains/runtime/workflow-runs.ts"]
      }
    ]
  }
}
